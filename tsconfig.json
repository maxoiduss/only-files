{
  "compilerOptions": {
    "types": ["vscode", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["ESNext"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,               /* enable all strict type-checking options */
    "noUnusedLocals": true,
    "noUnusedParameters": false,  /* Report errors on unused parameters.     */
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/tests/**/*.test.ts",
    "out",
    "node_modules"
  ]
}
