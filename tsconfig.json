{
	"compilerOptions": {
		"types": [
			"vscode",
			"node"
		],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2020",
		"outDir": "out",
		"rootDir": "src",
		"lib": ["ES2020"],
		"sourceMap": true,
		"inlineSources": true,
		"strict": true,   						/* enable all strict type-checking options */
		"noUnusedLocals": true,
    "noUnusedParameters": false   /* Report errors on unused parameters. */
	},
	"include": [
    "src/**/*"
  ],
	"exclude": [
    "src/tests/**/*.test.ts",
    "out",
    "node_modules"
  ]
}
