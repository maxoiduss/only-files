{
  "compilerOptions": {
    "types": ["node", "mocha"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["ES2024"],
    "noLib": false,
    "outDir": "out",
    "rootDir": "src",
    "strict": true,               /* enable all strict type-checking options */
    "removeComments": true,
    "sourceMap": true,
    "inlineSources": true,
    "noUnusedParameters": false,  /* Report errors on unused parameters.     */
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "exclude": [
    "out",
    "node_modules"
  ]
}
