// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ts-check",
      "icon": { "id": "symbol-interface", "color": "terminal.ansiBlue" },
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "es-build",
      "icon": { "id": "build", "color": "terminal.ansiGreen" },
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm-run",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ts-check",
        "es-build"
      ],
    }
  ]
}
