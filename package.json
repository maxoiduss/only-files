{
  "name": "just-files",
  "displayName": "Just Files",
  "description": "Select and work just with the files you will use",
  "version": "1.0.6",
  "publisher": "palaso",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/palaso0/just-files.git"
  },
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewView:preView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "webviewResources": [
      {
        "localRoot": "resources/pdfjs",
        "remoteRoot": "pdfjs"
      }
    ],
    "configuration": [
      {
        "title": "Just Files",
        "properties": {
          "justFiles.clickTime": {
            "type": "number",
            "default": 500,
            "minimum": 50,
            "maximum": 1000,
            "description": "Tolerance between clicks in millisec to trigger open file."
          },
          "justFiles.renameTime": {
            "type": "number",
            "default": 1500,
            "minimum": 1050,
            "maximum": 2500,
            "description": "Tolerance between clicks in millisec to trigger rename file."
          },
          "justFiles.showEmptyFolders": {
            "type": "boolean",
            "default": true,
            "description": "Should empty folders be shown when the whole project is uncollapsed to plain mode."
          },
          "justFiles.aDuplicatePostfix": {
            "type": "string",
            "default": "duplicate",
            "description": "A postfix used for names of duplicated files and folders."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "just-files-explorer",
          "title": "Just Files Explorer",
          "icon": "resources/folder.png",
          "order": 2
        },
        {
          "id": "preView-container",
          "title": "Preview",
          "icon": "resources/previewer.svg",
          "order": 1
        }
      ]
    },
    "views": {
      "just-files-explorer": [
        {
          "id": "justFilesView",
          "name": "Just Files",
          "type": "tree",
          "icon": "resources/justFolder.svg"
        },
        {
          "id": "filesView",
          "name": "Files",
          "type": "tree",
          "icon": "resources/folder.svg"
        }
      ],
      "preView-container": [
        {
          "id": "preView",
          "name": "Preview",
          "type": "webview",
          "icon": "resources/previewer.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "justFilesView",
        "contents": "Drag files here"
      },
      {
        "view": "filesView",
        "contents": "Loading the workspace..."
      }
    ],
    "colors": [
      {
        "id": "justFilesViewColor",
        "description": "Highlight color for the file decorator",
        "defaults": {
          "dark": "#6FD185",
          "light": "#6FD185",
          "highContrast": "#264D2E"
        }
      }
    ],
    "commands": [
      {
        "command": "just-files.showLogs",
        "title": "Show All Collected Logs"
      },
      {
        "command": "just-files.switch",
        "title": "Switch between classic/plain views",
        "icon": {
          "light": "resources/light/switchViewLight.svg",
          "dark": "resources/dark/switchViewDark.svg"
        }
      },
      {
        "command": "just-files.switchback",
        "title": "Switch between classic/plain views",
        "icon": {
          "light": "resources/light/switchbackViewLight.svg",
          "dark": "resources/dark/switchbackViewDark.svg"
        }
      },
      {
        "command": "just-files.show",
        "title": "Send to Just Files",
        "icon": {
          "light": "resources/light/showEyeLight.svg",
          "dark": "resources/dark/showEyeDark.svg"
        }
      },
      {
        "command": "just-files.hide",
        "title": "Remove from Just Files",
        "icon": {
          "light": "resources/light/hideEyeLight.svg",
          "dark": "resources/dark/hideEyeDark.svg"
        }
      },
      {
        "command": "just-files.removeAll",
        "title": "Remove all",
        "icon": {
          "light": "resources/light/broomNotFilledLight.svg",
          "dark": "resources/dark/broomNotFilledDark.svg"
        }
      },
      {
        "command": "just-files.ignore",
        "title": "Switch between use/don't use ignore-files",
        "icon": {
          "light": "resources/light/ignoreLight.svg",
          "dark": "resources/dark/ignoreDark.svg"
        }
      },
      {
        "command": "just-files.collapseFolder",
        "title": "Collapse to/from folder",
        "icon": {
          "light": "resources/light/collapsedLight.svg",
          "dark": "resources/dark/collapsedDark.svg"
        }
      },
      {
        "command": "just-files.searchListFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListLight.svg",
          "dark": "resources/dark/searchListDark.svg"
        }
      },
      {
        "command": "just-files.searchListJustFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListLight.svg",
          "dark": "resources/dark/searchListDark.svg"
        }
      },
      {
        "command": "just-files.uncollapseAll",
        "title": "Uncollapse All To Plain"
      },
      {
        "command": "just-files.remark",
        "title": "Mark/Unmark",
        "icon": {
          "light": "resources/light/markLight.svg",
          "dark": "resources/dark/markDark.svg"
        }
      },
      {
        "command": "just-files.addItemFromTabMenu",
        "title": "Send to Just Files"
      },
      {
        "command": "just-files.removeItemFromTabMenu",
        "title": "Remove from Just Files"
      },
      {
        "command": "just-files.addItemFromCommand",
        "title": "Send tab to Just Files"
      },
      {
        "command": "just-files.removeItemFromCommand",
        "title": "Remove tab from to Just Files"
      },
      {
        "command": "just-files.addItemFromExplorer",
        "title": "Send to Just Files"
      },
      {
        "command": "just-files.previewItem",
        "title": "Preview in Just Files",
        "icon": {
          "light": "resources/light/previewIconLight.svg",
          "dark": "resources/dark/previewIconDark.svg"
        }
      },
      {
        "command": "just-files.refreshFiles",
        "title": "Refresh Files",
        "icon": {
          "light": "resources/light/refreshIconLight.svg",
          "dark": "resources/dark/refreshIconDark.svg"
        }
      },
      {
        "command": "just-files.refreshJustFiles",
        "title": "Refresh JustFiles",
        "icon": {
          "light": "resources/light/refreshIconLight.svg",
          "dark": "resources/dark/refreshIconDark.svg"
        }
      },
      {
        "command": "just-files.refreshSortedJustFiles",
        "title": "Refresh JustFiles",
        "icon": {
          "light": "resources/light/refreshSortedIconLight.svg",
          "dark": "resources/dark/refreshSortedIconDark.svg"
        }
      },
      {
        "command": "just-files.revealInSidebar",
        "title": "Present file in sidebar",
        "icon": {
          "light": "resources/light/revealIconLight.svg",
          "dark": "resources/dark/revealIconDark.svg"
        }
      },
      {
        "command": "just-files.restore",
        "title": "Restore"
      },
      {
        "command": "just-files.rename",
        "title": "Rename"
      },
      {
        "command": "just-files.renameTab",
        "title": "Rename File"
      },
      {
        "command": "just-files.delete",
        "title": "Delete"
      },
      {
        "command": "just-files.deleteHard",
        "title": "Delete Permanently"
      },
      {
        "command": "just-files.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "just-files.emptify",
        "title": "Emptify"
      },
      {
        "command": "just-files.copy",
        "title": "Copy"
      },
      {
        "command": "just-files.cut",
        "title": "Cut"
      },
      {
        "command": "just-files.copyFilePath",
        "title": "Copy Path"
      },
      {
        "command": "just-files.copyRelativeFilePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "just-files.paste",
        "title": "Paste"
      },
      {
        "command": "just-files.findRef",
        "title": "Reveal References"
      },
      {
        "command": "just-files.revealFileInOS",
        "title": "Reveal in OS"
      },
      {
        "command": "just-files.newFolder",
        "title": "New Folder"
      },
      {
        "command": "just-files.newFile",
        "title": "New File"
      },
      {
        "command": "just-files.openFolder",
        "title": "Open Folder"
      },
      {
        "command": "just-files.closeFolder",
        "title": "Close Folder"
      },
      {
        "command": "just-files.ctrl",
        "title": "Copy Ctrl+Ctrl"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "command": "just-files.addItemFromExplorer",
          "group": "z"
        },
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "command": "just-files.previewItem",
          "group": "z"
        }
      ],
      "view/title": [
        {
          "command": "just-files.removeAll",
          "when": "view == justFilesView",
          "group": "navigation"
        },
        {
          "command": "just-files.switch",
          "when": "view == filesView && !just-files:isPlain",
          "group": "navigation"
        },
        {
          "command": "just-files.switchback",
          "when": "view == filesView && just-files:isPlain",
          "group": "navigation"
        },
        {
          "command": "just-files.ignore",
          "when": "view == filesView",
          "group": "navigation"
        },
        {
          "command": "just-files.refreshJustFiles",
          "when": "view == justFilesView && !just-files:isSorted",
          "group": "navigation"
        },
        {
          "command": "just-files.refreshSortedJustFiles",
          "when": "view == justFilesView && just-files:isSorted",
          "group": "navigation"
        },
        {
          "command": "just-files.refreshFiles",
          "when": "view == filesView",
          "group": "navigation"
        },
        {
          "command": "just-files.searchListFiles",
          "when": "view == filesView",
          "group": "navigation"
        },
        {
          "command": "just-files.searchListJustFiles",
          "when": "view == justFilesView",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "just-files.addItemFromTabMenu",
          "group": "z"
        },
        {
          "command": "just-files.removeItemFromTabMenu",
          "group": "z"
        },
        {
          "command": "just-files.renameTab",
          "group": "1_open"
        },
        {
          "command": "just-files.previewItem",
          "group": "z"
        }
      ],
      "view/item/context": [
        {
          "command": "just-files.revealInSidebar",
          "group": "inline",
          "when": "(view == filesView || view == justFilesView) && viewItem != empty && viewItem != root && viewItem != vac"
        },
        {
          "command": "just-files.openFolder",
          "when": "focusedView == filesView && viewItem == vac",
          "group": "0_navigation"
        },
        {
          "command": "just-files.closeFolder",
          "when": "focusedView == filesView && viewItem == root",
          "group": "6_other"
        },
        {
          "command": "just-files.revealFileInOS",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty",
          "group": "1_navigation"
        },
        {
          "command": "just-files.newFile",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "just-files.newFolder",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "just-files.findRef",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != folder && viewItem != empty && viewItem != root && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "just-files.copyFilePath",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty",
          "group": "3_cutcopypaste"
        },
        {
          "command": "just-files.copyRelativeFilePath",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty",
          "group": "3_cutcopypaste"
        },
        {
          "command": "just-files.copy",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root && viewItem != vac",
          "group": "2_cutcopypaste"
        },
        {
          "command": "just-files.cut",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac",
          "group": "2_cutcopypaste"
        },
        {
          "command": "just-files.paste",
          "when": "focusedView == filesView && viewItem != vac",
          "group": "2_cutcopypaste"
        },
        {
          "command": "just-files.uncollapseAll",
          "when": "focusedView == filesView",
          "group": "5_other"
        },
        {
          "command": "just-files.restore",
          "when": "(focusedView == justFilesView) && viewItem != empty && viewItem != folder",
          "group": "4_modification"
        },
        {
          "command": "just-files.rename",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "just-files.delete",
          "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "just-files.duplicate",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "just-files.emptify",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac && viewItem == folder",
          "group": "4_modification"
        },
        {
          "command": "just-files.collapseFolder",
          "group": "inline",
          "when": "view == filesView && viewItem != fileRoot && viewItem != root && viewItem != vac"
        },
        {
          "command": "just-files.remark",
          "group": "inline",
          "when": "view == justFilesView && viewItem != empty"
        },
        {
          "command": "just-files.show",
          "group": "inline",
          "when": "view == filesView && viewItem != root && viewItem != vac"
        },
        {
          "command": "just-files.hide",
          "group": "inline",
          "when": "view == justFilesView && viewItem != empty"
        },
        {
          "command": "just-files.previewItem",
          "group": "inline",
          "when": "(view == justFilesView && viewItem != empty) && viewItem != empty && viewItem != root && viewItem != folder"
        },
        {
          "command": "just-files.show",
          "when": "view == filesView && viewItem != empty && viewItem != root && viewItem != vac",
          "group": "default"
        },
        {
          "command": "just-files.hide",
          "when": "view == justFilesView && viewItem != empty",
          "group": "default"
        },
        {
          "command": "just-files.previewItem",
          "when": "viewItem != empty && viewItem != root && viewItem != folder",
          "group": "default"
        }
      ]
    },
    "keybindings": [
      {
        "command": "just-files.rename",
        "key": "f2",
        "mac": "f2",
        "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root"
      },
      {
        "command": "just-files.renameTab",
        "key": "shift+f2",
        "mac": "shift+f2",
        "when": "resourceScheme == file"
      },
      {
        "command": "just-files.delete",
        "key": "delete",
        "mac": "delete",
        "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root"
      },
      {
        "command": "just-files.deleteHard",
        "key": "shift+delete",
        "mac": "shift+delete",
        "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root"
      },
      {
        "command": "just-files.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty && viewItem != root"
      },
      {
        "command": "just-files.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "(focusedView == filesView) && viewItem != root"
      },
      {
        "command": "just-files.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == filesView"
      },
      {
        "command": "just-files.copyFilePath",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "(focusedView == filesView || focusedView == justFilesView) && viewItem != empty"
      },
      {
        "command": "just-files.previewItem",
        "key": "ctrl+shift+alt+enter",
        "mac": "cmd+shift+alt+enter",
        "when": "resourceScheme == file"
      },
      {
        "command": "just-files.show",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "(focusedView == filesView) && viewItem != root && viewItem != vac"
      },
      {
        "command": "just-files.hide",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "(focusedView == justFilesView) && viewItem != empty"
      },
      {
        "command": "just-files.addItemFromCommand",
        "key": "ctrl+y",
        "mac": "cmd+y",
        "when": "resourceScheme == file"
      },
      {
        "command": "just-files.removeItemFromCommand",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "resourceScheme == file"
      },
      {
        "command": "just-files.ctrl",
        "key": "ctrl+ctrl ctrl",
        "mac": "cmd+cmd cmd",
        "when": "(focusedView == filesView) && viewItem != root && viewItem != vac"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run prepublish",
    "prepublish": "npm run pretest && npm run justbuild",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run pretest && npm run runtest",
    "compile": "tsc -p ./",
    "build": "node ./esbuild.config.js --watch",
    "package": "vsce package",
    "justbuild": "node ./esbuild.config.js",
    "watch": "tsc -w -p ./ --noEmit",
    "lint": "eslint src",
    "runtest": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.1",
    "glob": "^8.1.0",
    "mocha": "^11.7.5",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "marked": "^16.4.1",
    "pdfjs-dist": "^5.4.296"
  }
}
