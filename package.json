    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "glob": "^8.1.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
