{
  "name": "only-files",
  "displayName": "Only Files",
  "description": "Select and work only with the files you will use",
  "version": "1.1.3",
  "publisher": "maxoiduss",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxoiduss/only-files.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "Explorer",
    "Files",
    "Folders",
    "Fullpath",
    "Path",
    "Select",
    "Focus",
    "Focused",
    "Only",
    "Preview",
    "PDF"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewView:pre-view"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "webviewResources": [
      {
        "localRoot": "resources/pdfjs",
        "remoteRoot": "pdfjs"
      }
    ],
    "configuration": [
      {
        "title": "Only Files",
        "properties": {
          "onlyFiles.clickTime": {
            "type": "number",
            "default": 500,
            "minimum": 50,
            "maximum": 1000,
            "scope": "application",
            "description": "Tolerance between clicks in millisec to trigger open file."
          },
          "onlyFiles.renameTime": {
            "type": "number",
            "default": 1500,
            "minimum": 1050,
            "maximum": 2500,
            "scope": "application",
            "description": "Tolerance between clicks in millisec to trigger rename file."
          },
          "onlyFiles.timeToPick": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 10,
            "scope": "application",
            "description": "Time in seconds quick pick dialog to auto accept."
          },
          "onlyFiles.timeToWaitOperations": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 10,
            "scope": "application",
            "description": "Time in seconds extension will wait before the filesystem operation breaks."
          },
          "onlyFiles.showUncollapsedFolders": {
            "type": "boolean",
            "default": true,
            "description": "Should uncollapsed folders be shown in the plain mode."
          },
          "onlyFiles.showEmptyFolders": {
            "type": "boolean",
            "default": true,
            "description": "Should empty folders be shown when the whole project is uncollapsed to plain mode."
          },
          "onlyFiles.showHiddenFilesHighlight": {
            "type": "boolean",
            "default": true,
            "description": "Should hidden files and folders be highlighted in files explorer."
          },
          "onlyFiles.aDuplicatePostfix": {
            "type": "string",
            "default": "duplicate",
            "description": "A postfix used for names of duplicated files and folders."
          },
          "onlyFiles.singleFileContentCopy": {
            "type": "boolean",
            "default": true,
            "description": "Should file content be copied on a single item copy."
          },
          "onlyFiles.useWatcherExclude": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "description": "Use or not file watcher exclusions for a project.",
            "markdownDescription": "Use file watcher extra exclusions for a project. \n\n Once you won't use it all these exclusions can be erased. \n\n You can [manage](command:only-files.manageWatcherExclude) exclusions manually. \n\n ⚠️ This [setting](#files.watcherExclude \"Apply this configuration exclusively under the Workspace or Folder tabs\") has **no effect** in global **_User_** settings."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "files-explorer",
          "title": "Files",
          "icon": "resources/holder.png",
          "order": 3
        },
        {
          "id": "only-files-explorer",
          "title": "Only",
          "icon": "resources/holder.png",
          "order": 2
        },
        {
          "id": "pre-view-explorer",
          "title": "Preview",
          "icon": "resources/holder.png",
          "order": 1
        }
      ]
    },
    "views": {
      "only-files-explorer": [
        {
          "id": "onlyFilesView",
          "name": "Only Files",
          "type": "tree",
          "icon": "resources/onlyFolder.svg"
        }
      ],
      "files-explorer": [
        {
          "id": "filesView",
          "name": "Only Folders",
          "type": "tree",
          "icon": "resources/folder.svg"
        }
      ],
      "pre-view-explorer": [
        {
          "id": "pre-view",
          "name": "Only",
          "when": "true",
          "type": "webview",
          "icon": "resources/previewer.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onlyFilesView",
        "contents": "Drag files here"
      },
      {
        "view": "filesView",
        "contents": "Loading the workspace..."
      },
      {
        "view": "pre-view",
        "contents": "<!DOCTYPE html><html><h3>Loading...</h3></html>",
        "when": "true"
      }
    ],
    "colors": [
      {
        "id": "onlyFilesViewColor",
        "description": "Highlight color for the file decorator",
        "defaults": {
          "dark": "#91B431",
          "light": "#91B431",
          "highContrast": "#005431"
        }
      },
      {
        "id": "foldersViewColor",
        "description": "Highlight color for the file decorator",
        "defaults": {
          "dark": "#D69952",
          "light": "#D69952",
          "highContrast": "#A86314"
        }
      }
    ],
    "commands": [
      {
        "command": "only-files.showLogs",
        "title": "Show Only Files Collected Logs"
      },
      {
        "command": "only-files.showSettings",
        "title": "Show Only Files Settings"
      },
      {
        "command": "only-files.showAll",
        "title": "Show All Possible Files"
      },
      {
        "command": "only-files.showExact",
        "title": "Show Only This One"
      },
      {
        "command": "only-files.showWarnings",
        "title": "Make Only Files Warnings Showable"
      },
      {
        "command": "only-files.manageWatcherExclude",
        "title": "Manage Files Watcher Exclusions"
      },
      {
        "command": "only-files.switch",
        "title": "Switch between classic/plain views",
        "icon": {
          "light": "resources/light/switchViewLight.svg",
          "dark": "resources/dark/switchViewDark.svg"
        }
      },
      {
        "command": "only-files.switchback",
        "title": "Switch between classic/plain views",
        "icon": {
          "light": "resources/light/switchbackViewLight.svg",
          "dark": "resources/dark/switchbackViewDark.svg"
        }
      },
      {
        "command": "only-files.show",
        "title": "Send to Only Files",
        "icon": {
          "light": "resources/light/showEyeLight.svg",
          "dark": "resources/dark/showEyeDark.svg"
        }
      },
      {
        "command": "only-files.hide",
        "title": "Remove from Only Files",
        "icon": {
          "light": "resources/light/hideEyeLight.svg",
          "dark": "resources/dark/hideEyeDark.svg"
        }
      },
      {
        "command": "only-files.removeAll",
        "title": "Remove all",
        "icon": {
          "light": "resources/light/removeAllLight.svg",
          "dark": "resources/dark/removeAllDark.svg"
        }
      },
      {
        "command": "only-files.ignore",
        "title": "Switch between use/don't use ignore-files",
        "icon": {
          "light": "resources/light/ignoreLight.svg",
          "dark": "resources/dark/ignoreDark.svg"
        }
      },
      {
        "command": "only-files.ignoreback",
        "title": "Switch between use/don't use ignore-files",
        "icon": {
          "light": "resources/light/ignorebackLight.svg",
          "dark": "resources/dark/ignorebackDark.svg"
        }
      },
      {
        "command": "only-files.collapseFolder",
        "title": "Collapse to/from folder",
        "icon": {
          "light": "resources/light/collapsedLight.svg",
          "dark": "resources/dark/collapsedDark.svg"
        }
      },
      {
        "command": "only-files.searchListFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListLight.svg",
          "dark": "resources/dark/searchListDark.svg"
        }
      },
      {
        "command": "only-files.searchListOnlyFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListLight.svg",
          "dark": "resources/dark/searchListDark.svg"
        }
      },
      {
        "command": "only-files.searchListActiveFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListActiveLight.svg",
          "dark": "resources/dark/searchListActiveDark.svg"
        }
      },
      {
        "command": "only-files.searchListActiveOnlyFiles",
        "title": "Search among shown elements",
        "icon": {
          "light": "resources/light/searchListActiveLight.svg",
          "dark": "resources/dark/searchListActiveDark.svg"
        }
      },
      {
        "command": "only-files.uncollapseAll",
        "title": "Uncollapse All To Plain"
      },
      {
        "command": "only-files.remark",
        "title": "Mark/Unmark",
        "icon": {
          "light": "resources/light/markLight.svg",
          "dark": "resources/dark/markDark.svg"
        }
      },
      {
        "command": "only-files.addItemFromTabMenu",
        "title": "Send to Only Files"
      },
      {
        "command": "only-files.removeItemFromTabMenu",
        "title": "Remove from Only Files"
      },
      {
        "command": "only-files.addItemFromCommand",
        "title": "Send tab to Only Files"
      },
      {
        "command": "only-files.removeItemFromCommand",
        "title": "Remove tab from to Only Files"
      },
      {
        "command": "only-files.addItemFromExplorer",
        "title": "Send to Only Files"
      },
      {
        "command": "only-files.previewItemFromTab",
        "title": "Preview in Only Files"
      },
      {
        "command": "only-files.previewItem",
        "title": "Preview in Only Files",
        "icon": {
          "light": "resources/light/previewIconLight.svg",
          "dark": "resources/dark/previewIconDark.svg"
        }
      },
      {
        "command": "only-files.refreshFiles",
        "title": "Refresh",
        "icon": {
          "light": "resources/light/refreshIconLight.svg",
          "dark": "resources/dark/refreshIconDark.svg"
        }
      },
      {
        "command": "only-files.refreshOnlyFiles",
        "title": "Refresh/Reorder",
        "icon": {
          "light": "resources/light/refreshIconLight.svg",
          "dark": "resources/dark/refreshIconDark.svg"
        }
      },
      {
        "command": "only-files.refreshSortedOnlyFiles",
        "title": "Refresh OnlyFiles",
        "icon": {
          "light": "resources/light/refreshSortedIconLight.svg",
          "dark": "resources/dark/refreshSortedIconDark.svg"
        }
      },
      {
        "command": "only-files.revealInSidebar",
        "title": "Present file in sidebar",
        "icon": {
          "light": "resources/light/revealIconLight.svg",
          "dark": "resources/dark/revealIconDark.svg"
        }
      },
      {
        "command": "only-files.restore",
        "title": "Restore"
      },
      {
        "command": "only-files.rename",
        "title": "Rename"
      },
      {
        "command": "only-files.renameTab",
        "title": "Rename File"
      },
      {
        "command": "only-files.delete",
        "title": "Delete"
      },
      {
        "command": "only-files.deleteHard",
        "title": "Delete Permanently"
      },
      {
        "command": "only-files.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "only-files.emptify",
        "title": "Emptify"
      },
      {
        "command": "only-files.copy",
        "title": "Copy"
      },
      {
        "command": "only-files.cut",
        "title": "Cut"
      },
      {
        "command": "only-files.collect",
        "title": "Collect All Marked"
      },
      {
        "command": "only-files.refuse",
        "title": "Refuse All Marked"
      },
      {
        "command": "only-files.copyFilePath",
        "title": "Copy Path"
      },
      {
        "command": "only-files.copyRelativeFilePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "only-files.paste",
        "title": "Paste"
      },
      {
        "command": "only-files.findRef",
        "title": "Reveal References"
      },
      {
        "command": "only-files.revealFileInOS",
        "title": "Reveal in OS"
      },
      {
        "command": "only-files.newFolder",
        "title": "New Folder"
      },
      {
        "command": "only-files.newFile",
        "title": "New File"
      },
      {
        "command": "only-files.openFolder",
        "title": "Open Folder"
      },
      {
        "command": "only-files.closeFolder",
        "title": "Close Folders"
      },
      {
        "command": "only-files.ctrl",
        "title": "Copy Ctrl+Ctrl"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "only-files.addItemFromExplorer",
          "when": "resourceScheme && resourceScheme != untitled",
          "group": "z"
        },
        {
          "command": "only-files.previewItem",
          "when": "resourceScheme && resourceScheme != untitled",
          "group": "z"
        }
      ],
      "view/title": [
        {
          "command": "only-files.removeAll",
          "when": "view == onlyFilesView",
          "group": "navigation"
        },
        {
          "command": "only-files.switch",
          "when": "view == filesView && !only-files:isPlain",
          "group": "navigation"
        },
        {
          "command": "only-files.switchback",
          "when": "view == filesView && only-files:isPlain",
          "group": "navigation"
        },
        {
          "command": "only-files.ignore",
          "when": "view == filesView && !only-files:isIgnored",
          "group": "navigation"
        },
        {
          "command": "only-files.ignoreback",
          "when": "view == filesView && only-files:isIgnored",
          "group": "navigation"
        },
        {
          "command": "only-files.refreshOnlyFiles",
          "when": "view == onlyFilesView && !only-files:isSorted",
          "group": "navigation"
        },
        {
          "command": "only-files.refreshSortedOnlyFiles",
          "when": "view == onlyFilesView && only-files:isSorted",
          "group": "navigation"
        },
        {
          "command": "only-files.refreshFiles",
          "when": "view == filesView",
          "group": "navigation"
        },
        {
          "command": "only-files.searchListFiles",
          "when": "view == filesView && only-files:isActive",
          "group": "navigation"
        },
        {
          "command": "only-files.searchListOnlyFiles",
          "when": "view == onlyFilesView && !only-files:isActive",
          "group": "navigation"
        },
        {
          "command": "only-files.searchListActiveFiles",
          "when": "view == filesView && !only-files:isActive",
          "group": "navigation"
        },
        {
          "command": "only-files.searchListActiveOnlyFiles",
          "when": "view == onlyFilesView && only-files:isActive",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "only-files.addItemFromTabMenu",
          "group": "z"
        },
        {
          "command": "only-files.removeItemFromTabMenu",
          "group": "z"
        },
        {
          "command": "only-files.renameTab",
          "group": "1_open",
          "when": "resourceScheme && resourceScheme != untitled"
        },
        {
          "command": "only-files.previewItemFromTab",
          "group": "z",
          "when": "resourceScheme && resourceScheme != untitled"
        }
      ],
      "view/item/context": [
        {
          "command": "only-files.revealInSidebar",
          "group": "inline",
          "when": "(view == filesView || view == onlyFilesView) && viewItem != dummy && viewItem != root && viewItem != vac"
        },
        {
          "command": "only-files.openFolder",
          "when": "focusedView == filesView && viewItem == vac",
          "group": "0_navigation"
        },
        {
          "command": "only-files.closeFolder",
          "when": "focusedView == filesView && viewItem == root",
          "group": "7_other"
        },
        {
          "command": "only-files.revealFileInOS",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy",
          "group": "1_navigation"
        },
        {
          "command": "only-files.newFile",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "only-files.newFolder",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "only-files.findRef",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != folder && viewItem != empty && viewItem != dummy && viewItem != root && viewItem != vac",
          "group": "1_navigation"
        },
        {
          "command": "only-files.copyFilePath",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy",
          "group": "3_cutcopypaste"
        },
        {
          "command": "only-files.copyRelativeFilePath",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy",
          "group": "3_cutcopypaste"
        },
        {
          "command": "only-files.copy",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root && viewItem != vac",
          "group": "2_cutcopypaste"
        },
        {
          "command": "only-files.cut",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac",
          "group": "2_cutcopypaste"
        },
        {
          "command": "only-files.paste",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != vac && viewItem != dummy",
          "group": "2_cutcopypaste"
        },
        {
          "command": "only-files.collect",
          "when": "focusedView == onlyFilesView",
          "group": "5_other"
        },
        {
          "command": "only-files.refuse",
          "when": "focusedView == onlyFilesView && viewItem == dummy",
          "group": "5_other"
        },
        {
          "command": "only-files.showAll",
          "when": "focusedView == onlyFilesView && viewItem != dummy",
          "group": "5_other"
        },
        {
          "command": "only-files.showExact",
          "when": "focusedView == onlyFilesView && viewItem != dummy",
          "group": "5_other"
        },
        {
          "command": "only-files.uncollapseAll",
          "when": "focusedView == filesView",
          "group": "5_other"
        },
        {
          "command": "only-files.showSettings",
          "when": "focusedView == filesView && viewItem == root",
          "group": "6_other"
        },
        {
          "command": "only-files.restore",
          "when": "(focusedView == onlyFilesView) && viewItem != dummy && viewItem != folder",
          "group": "4_modification"
        },
        {
          "command": "only-files.rename",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "only-files.delete",
          "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "only-files.duplicate",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac",
          "group": "4_modification"
        },
        {
          "command": "only-files.emptify",
          "when": "focusedView == filesView && viewItem != root && viewItem != vac && viewItem == folder",
          "group": "4_modification"
        },
        {
          "command": "only-files.collapseFolder",
          "group": "inline",
          "when": "view == filesView && (only-files:isPlain || viewItem != file) && viewItem != rooting && viewItem != root && viewItem != vac"
        },
        {
          "command": "only-files.remark",
          "group": "inline",
          "when": "view == onlyFilesView && viewItem != dummy"
        },
        {
          "command": "only-files.show",
          "group": "inline",
          "when": "view == filesView && viewItem != root && viewItem != empty && viewItem != vac"
        },
        {
          "command": "only-files.hide",
          "group": "inline",
          "when": "view == onlyFilesView && viewItem != dummy"
        },
        {
          "command": "only-files.previewItem",
          "group": "inline",
          "when": "view == onlyFilesView && viewItem != dummy && viewItem != empty && viewItem != root && viewItem != folder"
        },
        {
          "command": "only-files.show",
          "when": "view == filesView && viewItem != dummy && viewItem != root && viewItem != empty && viewItem != vac",
          "group": "default"
        },
        {
          "command": "only-files.hide",
          "when": "view == onlyFilesView && viewItem != dummy",
          "group": "default"
        },
        {
          "command": "only-files.previewItem",
          "when": "viewItem != dummy && viewItem != root && viewItem != folder && viewItem != empty",
          "group": "default"
        }
      ]
    },
    "keybindings": [
      {
        "command": "only-files.rename",
        "key": "f2",
        "mac": "f2",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root"
      },
      {
        "command": "only-files.renameTab",
        "key": "shift+f2",
        "mac": "shift+f2",
        "when": "resourceScheme && resourceScheme != untitled"
      },
      {
        "command": "only-files.delete",
        "key": "delete",
        "mac": "delete",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root"
      },
      {
        "command": "only-files.deleteHard",
        "key": "shift+delete",
        "mac": "shift+delete",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root"
      },
      {
        "command": "only-files.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy && viewItem != root"
      },
      {
        "command": "only-files.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != root"
      },
      {
        "command": "only-files.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == filesView || focusedView == onlyFilesView"
      },
      {
        "command": "only-files.copyFilePath",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != dummy"
      },
      {
        "command": "only-files.previewItemFromTab",
        "key": "shift+space v",
        "mac": "shift+space v",
        "when": "editorFocus == true && resourceScheme && resourceScheme != untitled"
      },
      {
        "command": "only-files.previewItem",
        "key": "shift+space v",
        "mac": "shift+space v",
        "when": "true"
      },
      {
        "command": "only-files.refreshFiles",
        "key": "shift+space a",
        "mac": "shift+space a",
        "when": "true"
      },
      {
        "command": "only-files.refreshOnlyFiles",
        "key": "shift+space z",
        "mac": "shift+space z",
        "when": "true"
      },
      {
        "command": "only-files.switch",
        "key": "shift+space shift+space",
        "mac": "shift+space shift+space",
        "when": "!only-files:isPlain"
      },
      {
        "command": "only-files.switchback",
        "key": "shift+space shift+space",
        "mac": "shift+space shift+space",
        "when": "only-files:isPlain"
      },
      {
        "command": "only-files.addItemFromExplorer",
        "key": "shift+space c",
        "mac": "shift+space c",
        "when": "focusedView == 'workbench.explorer.fileView'"
      },
      {
        "command": "only-files.addItemFromTabMenu",
        "key": "shift+space c",
        "mac": "shift+space c",
        "when": "editorFocus == true && resourceScheme && resourceScheme != untitled"
      },
      {
        "command": "only-files.removeItemFromTabMenu",
        "key": "shift+space x",
        "mac": "shift+space x",
        "when": "editorFocus == true && resourceScheme && resourceScheme != untitled"
      },
      {
        "command": "only-files.addItemFromCommand",
        "key": "shift+space c",
        "mac": "shift+space c",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != empty && viewItem != root && viewItem != vac"
      },
      {
        "command": "only-files.removeItemFromCommand",
        "key": "shift+space x",
        "mac": "shift+space x",
        "when": "(focusedView == filesView || focusedView == onlyFilesView) && viewItem != empty && viewItem != root && viewItem != vac"
      },
      {
        "command": "only-files.ctrl",
        "key": "ctrl+ctrl ctrl",
        "mac": "cmd+cmd cmd",
        "when": "(focusedView == filesView) && viewItem != root && viewItem != vac"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run prepublish",
    "prepublish": "npm run pretest && npm run onlybuild",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run pretest && npm run tstest",
    "compile": "tsc -p ./",
    "builddesk": "node --env-file=./vars/.env ./esbuild.config.js --watch",
    "buildweb": "node --env-file=./vars/.env ./esbuild.config.js --watch --web",
    "buildtest": "node --env-file=./vars/.env.test ./esbuild.config.js --tests",
    "package": "vsce package",
    "onlybuild": "node ./esbuild.config.js",
    "check": "tsc -p ./ --noEmit && node scripts/check.js",
    "lint": "eslint src && eslint scripts && tsc -p tsconfig.json --noEmit",
    "unittest": "node --env-file=./vars/.env.test ./src/tests/units/run.mts",
    "integrationtest": "vscode-test"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.81",
    "chai": "^6.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
